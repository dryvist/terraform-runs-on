use flake "github:JacobPEvans/nix-devenv?dir=shells/terraform"

# Canonical IaC binary for this repo is OpenTofu (tofu). Both `terraform`
# and `tofu` ship in the dev shell; the env vars below force every
# downstream tool to dispatch to `tofu` so the OpenTofu lockfile format
# (registry.opentofu.org/...) stays canonical whether checks run locally
# or in CI.
#
#   PCT_TFPATH        antonbabenko/pre-commit-terraform hook dispatcher
#   TERRAGRUNT_TFPATH terragrunt's underlying-binary selector
export PCT_TFPATH=tofu
export TERRAGRUNT_TFPATH=tofu
